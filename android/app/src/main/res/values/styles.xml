<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EldenEarth" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">#FF0A0A0A</item>
        <item name="android:navigationBarColor">#FF0A0A0A</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.EldenEarth.Boot">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">#FF0A0A0A</item>
        <item name="android:navigationBarColor">#FF0A0A0A</item>
    </style>

    <style name="Theme.EldenEarth.Game">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/elden_bg</item>
        <item name="android:statusBarColor">#FF0A0A0A</item>
        <item name="android:navigationBarColor">#FF0A0A0A</item>
    </style>

    <style name="EldenDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@color/elden_panel</item>
        <item name="android:textColorPrimary">@color/elden_text</item>
        <item name="android:textColor">@color/elden_text</item>
        <item name="colorAccent">@color/elden_red</item>
    </style>
</resources>
