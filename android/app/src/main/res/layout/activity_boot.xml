<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/boot_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0A0A"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="40dp">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/boot_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ELDEN\nEARTH"
            android:fontFamily="sans-serif-black"
            android:textSize="48sp"
            android:textColor="#FFFF3333"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingMultiplier="0.9"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:alpha="0" />

        <TextView
            android:id="@+id/boot_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="BUILD 0.0.0"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#80FFFFFF"
            android:letterSpacing="0.2" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/boot_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Initializing..."
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="#66FF3333"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/boot_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="12dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar" />

        <TextView
            android:id="@+id/boot_compile_log"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:textColor="#44FF3333"
            android:background="#0AFFFFFF"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:gravity="bottom" />

    </LinearLayout>

</FrameLayout>
