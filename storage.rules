rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Avatar uploads — authenticated users can write only to their own folder
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 512 * 1024;
    }

    // Default deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
